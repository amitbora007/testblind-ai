# ==============================================================================
# TestBlind AI — Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in the backend directory and adjust values as needed.

# Application Information
PROJECT_NAME="TestBlind AI Control Plane"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication
# IMPORTANT: Generate a secure 32+ byte key for production (e.g., openssl rand -hex 32)
SECRET_KEY="testblind-super-secret-jwt-key-for-development-change-in-prod-32bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="testblind_admin"
POSTGRES_PASSWORD="testblind_dev_password_change_me"
POSTGRES_DB="testblind_db"
# Optional explicit database URI (takes precedence over POSTGRES_* if set):
# DATABASE_URL="postgresql+asyncpg://testblind_admin:testblind_dev_password_change_me@localhost:5432/testblind_db"

# Redis Cache & Queue Broker
REDIS_URL="redis://localhost:6379/0"

# Execution Infrastructure & Runner Sandboxes
DOCKER_HOST_SOCKET="/var/run/docker.sock"
SANDBOX_BASE_DIR="/tmp/testblind_sandboxes"
MAX_CONCURRENT_WORKERS=4
MAX_TENANT_CONCURRENT_RUNS=2
EXECUTION_DEFAULT_TIMEOUT_SECONDS=30
EXECUTION_WALL_TIMEOUT_SECONDS=60
EXECUTION_MAX_MEMORY_MB=512
EXECUTION_MAX_OUTPUT_BYTES=1048576

# Repository Archive & File Storage Quotas
UPLOAD_MAX_SIZE_BYTES=104857600
UPLOAD_RETENTION_HOURS=24

# GitHub Integration (Optional - set if connecting GitHub App or OAuth)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY_PATH=""
GITHUB_WEBHOOK_SECRET=""

# CORS Allowed Origins (Comma-separated or JSON list in production)
# Default allows localhost dev servers: 3000, 4173, 5173
